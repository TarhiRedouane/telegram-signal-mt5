sequenceDiagram
    autonumber
    participant OS as OS Signal/Console
    participant M as main()
    participant A as ApplicationManager
    participant TG as Telegram/Auth
    participant MH as MessageHandler
    participant RP as RegexParser
    participant LP as LLMParser
    participant MT5 as MT5ConnectionManager
    participant DB as SignalRepository/Database
    participant MON as Health+Dashboard

    M->>A: startup()
    A->>TG: startup_authentication()
    TG-->>A: authenticated client
    A->>MON: init/start monitoring
    A->>DB: initialize_database + repository
    A->>TG: connect_to_groups (retry up to 3)
    A->>MH: register event handler
    A->>MT5: initialize in background
    M->>A: run() wait for shutdown_event

    TG->>MH: new message
    MH->>A: _on_telegram_message(metadata)
    A->>A: dedupe chat_id+message_id
    A->>RP: parse(raw_text)

    alt regex success
        RP-->>A: parsed_signal
    else regex fails
        A->>LP: parse_with_llm(raw_text)
        LP-->>A: parsed_signal or None
    end

    alt parsed_signal exists
        A->>MT5: get_current_price(symbol)
        MT5-->>A: current_price
        alt price valid
            A->>DB: save_signal(...)
            A->>MON: update metrics/dashboard
        else price invalid
            A->>A: reject + log
        end
    else no parsed signal
        A->>A: parse failed + log
    end

    OS->>M: SIGINT/SIGTERM
    M->>A: signal_shutdown()
    M->>A: shutdown()
    A->>A: save state files
    A->>MON: stop dashboard + health monitor
    A->>TG: cleanup client
    A->>MT5: shutdown manager
    A->>DB: close database
    A->>A: cancel background tasks