# Telegram API Configuration
TELEGRAM_API_ID=xxxxx
TELEGRAM_API_HASH=xxxxx
PHONE_NUMBER=your_phone_number_with_country_code
TELEGRAM_GROUPS=@signalgroup1,@signalgroup2,@signalgroup3

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_VARIANT=gpt-5-mini
LLM_REASONING_LEVEL=minimal
LLM_VERBOSITY=low
LLM_CACHE_TTL_HOURS=24
LLM_MAX_RETRIES=3

# MetaTrader5 Configuration  
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server
MT5_PATH=
# Terminal started with /portable (its data lives in its own folder)
MT5_PORTABLE=false
# demo or real: the bot refuses a terminal logged in to the other kind of account
MT5_ACCOUNT_MODE=demo

# Broker instances (several robot terminals): profiles in config/brokers.json
# (copy config/brokers.example.json), start with `python cli.py start` (menu).
# Each profile overrides MT5_PATH/LOGIN/SERVER/PORTABLE/ACCOUNT_MODE above; password per broker:
# BROKER_RAISE_PASSWORD=
# BROKER_VT_PASSWORD=
MT5_ACCOUNT_CURRENCY=USD
MT5_TIMEOUT_SECONDS=60
MT5_MAX_CONNECTIONS=5
MT5_RECONNECT_DELAY=5

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///data/signal_ea.db

# Application Settings
DEV_MODE=false
LOG_LEVEL=INFO
MAX_CONCURRENT_TRADES=3
DEFAULT_RISK_PERCENT=1.0

# Risk guard (checked before every order). Create data/STOP_TRADING to block new entries live.
RISK_PERCENT=3.0
MAX_OPEN_RISK_PERCENT=6.0
MAX_OPEN_LEGS=6
DAILY_LOSS_LIMIT_PERCENT=6.0
TRADING_ENABLED=true
KILL_SWITCH_FILE=data/STOP_TRADING

# Rate Limiting
TELEGRAM_RATE_LIMIT_DELAY=2.0
LLM_RATE_LIMIT_RPM=60

# Trading Parameters
DEFAULT_SL_PIPS=20
DEFAULT_TP_PIPS=30
BREAK_EVEN_TRIGGER_PIPS=15
BASE_CURRENCY=USD
DEFAULT_LOT_SIZE=0.01
GOLD_PRICE_MIN=2000
GOLD_PRICE_MAX=10000
GOLD_MAX_PRICE_DEVIATION=100

# Monitoring
HEALTH_CHECK_INTERVAL=300
METRICS_EXPORT_INTERVAL=3600