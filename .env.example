# Telegram API Configuration
TELEGRAM_API_ID=xxxxx
TELEGRAM_API_HASH=xxxxx
PHONE_NUMBER=your_phone_number_with_country_code
TELEGRAM_GROUPS=@signalgroup1,@signalgroup2,@signalgroup3

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_VARIANT=gpt-5-mini
LLM_REASONING_LEVEL=minimal
LLM_VERBOSITY=low
LLM_CACHE_TTL_HOURS=24
LLM_MAX_RETRIES=3

# MetaTrader5 Configuration
# Broker profiles (account, server, terminal path, demo/real): config/brokers.json
# (copy config/brokers.example.json). `python cli.py start` shows a menu of brokers;
# BOT_INSTANCE is the broker used by a plain `python main.py`.
BOT_INSTANCE=raise
# One password per broker profile
BROKER_RAISE_PASSWORD=your_raise_demo_password
# BROKER_VT_PASSWORD=your_vt_demo_password
MT5_ACCOUNT_CURRENCY=USD
MT5_TIMEOUT_SECONDS=60
MT5_MAX_CONNECTIONS=5
MT5_RECONNECT_DELAY=5

# Application Settings
DEV_MODE=false
LOG_LEVEL=INFO
MAX_CONCURRENT_TRADES=3
DEFAULT_RISK_PERCENT=1.0

# Risk guard (checked before every order). Create data/STOP_TRADING to block new entries live.
RISK_PERCENT=3.0
MAX_OPEN_RISK_PERCENT=6.0
MAX_OPEN_LEGS=6
DAILY_LOSS_LIMIT_PERCENT=6.0
TRADING_ENABLED=true
KILL_SWITCH_FILE=data/STOP_TRADING

# Rate Limiting
TELEGRAM_RATE_LIMIT_DELAY=2.0
LLM_RATE_LIMIT_RPM=60

# Trading Parameters
DEFAULT_SL_PIPS=20
DEFAULT_TP_PIPS=30
BREAK_EVEN_TRIGGER_PIPS=15
BASE_CURRENCY=USD
DEFAULT_LOT_SIZE=0.01
GOLD_PRICE_MIN=2000
GOLD_PRICE_MAX=10000
GOLD_MAX_PRICE_DEVIATION=100
# Single signals: SL at least this far from the market, in price units (2.0 = 20 pips at 0.10/pip),
# unless the post's own stop is tighter
GOLD_MIN_SL_DISTANCE=2.0
# Opposite "buy/sell gold now" while a trade is open: refused closer than this to its entry
# (30.0 = 300 pips); at or beyond it, one half-risk counter-trade with this default TP (10.0 = 100 pips)
GOLD_MIN_REVERSAL_DISTANCE=30.0
GOLD_COUNTER_TP_DISTANCE=10.0

# Monitoring
HEALTH_CHECK_INTERVAL=300
METRICS_EXPORT_INTERVAL=3600